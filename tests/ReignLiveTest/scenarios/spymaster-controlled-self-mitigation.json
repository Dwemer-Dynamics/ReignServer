{
  "schemaVersion": 2,
  "label": "Spymaster controlled acceptance - exact player rumor and reputation mitigation successes",
  "mode": "spymaster",
  "presentation": "visible",
  "effects": "full",
  "precondition": "Run only when the player's production social status contains at least one rumor and one reputation.",
  "steps": [
    { "operation": "ui_open", "targetSearch": "spymaster", "timeoutSeconds": 60 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "reputation", "timeoutSeconds": 30 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "select-target", "value": "player", "timeoutSeconds": 30 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "select-action", "value": "mitigate_own_rumor", "timeoutSeconds": 30 },
    { "operation": "wait_for_memory", "waitMilliseconds": 15000, "timeoutSeconds": 45 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "select-social-item", "value": "first", "timeoutSeconds": 30 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "begin", "timeoutSeconds": 30 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "select-action", "value": "mitigate_own_reputation", "timeoutSeconds": 30 },
    { "operation": "wait_for_memory", "waitMilliseconds": 15000, "timeoutSeconds": 45 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "select-social-item", "value": "first", "timeoutSeconds": 30 },
    { "operation": "ui_action", "targetSearch": "spymaster", "text": "begin", "timeoutSeconds": 30 },
    { "operation": "spymaster_organic", "phase": "capture", "batch": "controlled_player_social_mitigation", "minimumNewMissions": 2, "fixtureRunId": "spymaster_organic_launch", "timeoutSeconds": 120 },
    { "operation": "spymaster_organic", "phase": "control_outcomes", "batch": "controlled_player_social_mitigation", "missionTypes": ["mitigate_own_rumor", "mitigate_own_reputation"], "minimum": 2, "unitRoll": 0.0, "confirmation": "force Reign Spymaster outcomes on disposable save", "fixtureRunId": "spymaster_organic_launch", "timeoutSeconds": 120 },
    { "operation": "ui_close", "timeoutSeconds": 30 },
    { "operation": "world_advance", "mode": "passive_world", "days": 12, "timeoutSeconds": 7200 },
    { "operation": "wait_for_memory", "waitMilliseconds": 5000, "timeoutSeconds": 30 },
    { "operation": "spymaster_organic", "phase": "verify_controlled_outcomes", "batch": "controlled_player_social_mitigation", "missionTypes": ["mitigate_own_rumor", "mitigate_own_reputation"], "minimum": 2, "fixtureRunId": "spymaster_organic_launch", "timeoutSeconds": 120 },
    { "operation": "spymaster_organic", "phase": "observe", "stage": "after_controlled_player_social_mitigation", "fixtureRunId": "spymaster_organic_launch", "timeoutSeconds": 120 }
  ]
}
