<Application x:Class="Bannerlord.NativeCharacterImageGenerator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#10131A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#181D27" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202633" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA7B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C49A5A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#11141A" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="#343C4B" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
