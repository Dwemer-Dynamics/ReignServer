#!/usr/bin/env bash
# Dedicated ReignServer WSL runtime lifecycle.
set -euo pipefail
root=/var/www/html/ReignServer/runtime
data=/var/www/html/ReignServer/data
source_root=/var/www/html/ReignServer
pidfile=/run/reignserver/server.pid
unit=reignserver.service
delegate=${pidfile%/*}/lifecycle-delegate
command=${1:-status}
if [ "$(id -u)" != 0 ]; then exec sudo "$0" "$@"; fi
# Public lifecycle calls must use the same service owner as Control Center.
# systemd supplies INVOCATION_ID to ExecStart/ExecStop; those callbacks alone
# perform the process work below. Dispatch before locking: the callback needs
# the runtime lease too, and waiting on systemctl while holding it deadlocks.
if [[ "$command" = start || "$command" = stop ]] && [ -z "${INVOCATION_ID:-}" ]; then
    exec /usr/bin/systemctl "$command" reignserver.service
fi

process_stamp() {
    local stat fields
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    read -r -a fields <<<"${stat##*) }"
    printf '%s\n' "${fields[19]:-}"
}

# An activation keeps the runtime lease while it waits on the unit's own start
# or stop job. Only those systemd callbacks may act inside that lease, and only
# while a root-owned delegation names the live root process that still holds it.
lease_delegated() {
    [ -n "${INVOCATION_ID:-}" ] && [ -f "$delegate" ] && [ ! -L "$delegate" ] || return 1
    [ "$(stat -c %u "$delegate")" = 0 ] || return 1
    local holder stamp
    read -r holder stamp < "$delegate" || return 1
    [[ "$holder" =~ ^[1-9][0-9]*$ ]] && [ -n "$stamp" ] || return 1
    [ "$(process_stamp "$holder")" = "$stamp" ] && [ "$(stat -c %u "/proc/$holder")" = 0 ] || return 1
    [ "/proc/$holder/fd/8" -ef /run/lock/reignserver-runtime.lock ] || return 1
    ! flock -n 9 9</run/lock/reignserver-runtime.lock
}

case "$command" in
    prepare|configure-web|activate|start|stop|rollback|rollback-list|repair-permissions|commit-activation|abort-activation)
        exec 8>/run/lock/reignserver-runtime.lock
        if [[ "$command" = start || "$command" = stop ]] && lease_delegated; then
            : # The waiting lease holder requested exactly this unit job.
        elif [ "$command" = configure-web ] && [ "/proc/$$/fd/9" -ef /run/lock/reignserver-runtime.lock ] && flock -n 9; then
            : # install-reign-control.sh lends the lease it holds on fd 9 (or this takes it there).
        else
            flock -w 30 8 || { echo 'Another Reign runtime operation is running.' >&2; exit 75; }
        fi
        ;;
esac

running() {
    [ -s "$pidfile" ] || return 1
    pid=$(cat "$pidfile")
    [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    local executable
    for executable in "$root/current/ReignServer" "$root/current/ReignBetaServer"; do
        [ -f "$executable" ] && [ "$executable" -ef "/proc/$pid/exe" ] && return 0
    done
    return 1
}

stop() {
    if running; then
        # setsid creates an owned session, so only this server and its worker group receive signals.
        [ "$(ps -o sid= -p "$pid" | tr -d ' ')" = "$pid" ] || { echo 'Reign process ownership mismatch.' >&2; exit 1; }
        kill -TERM -- "-$pid"
        for attempt in $(seq 1 30); do running || break; sleep 1; done
        if running; then echo 'Reign did not stop cleanly; files were not replaced.' >&2; exit 1; fi
    fi
    rm -f "$pidfile"
}

# Windows UNC clients can create root-owned campaign and portrait files.
repair_permissions() {
    local directory
    for directory in "$data" "$data/campaigns" "$data/PortraitCache"; do
        [ ! -L "$directory" ] || { echo 'Redirected campaign roots are not supported.' >&2; return 1; }
    done
    command -v setfacl >/dev/null || { echo 'Reign permissions need preparation (acl package missing).' >&2; return 1; }
    install -d -o reign -g reign -m 700 "$data" "$data/campaigns" "$data/PortraitCache" || return 1
    # Do not traverse symlinks or other mounts, or change any campaign contents.
    for directory in "$data/campaigns" "$data/PortraitCache"; do
        # The shipped shared library is protected and never part of campaign repair.
        find -P "$directory" -xdev -name _shared -prune -o \( -type d -o -type f \) -exec chown --no-dereference reign:reign {} + || return 1
        find -P "$directory" -xdev -name _shared -prune -o -type d -exec setfacl -m u::rwx,u:reign:rwx,g::---,o::---,d:u::rwx,d:u:reign:rwx,d:g::---,d:o::--- {} + || return 1
        find -P "$directory" -xdev -name _shared -prune -o -type f -exec setfacl -m u::rw,u:reign:rw,g::---,o::--- {} + || return 1
    done
}

# The lifecycle controller owns the PID record, including the write. A previous
# root-owned record must never be opened by the unprivileged server shell.
start_server_process() {
    local executable=$1 python_root=$2 model_root=$3 bannerlord_modules=$4
    local pid_directory=${pidfile%/*}
    [ ! -L "$pid_directory" ] && [ ! -L "$pidfile" ] &&
        { [ ! -e "$pidfile" ] || [ -f "$pidfile" ]; } || {
        echo 'Redirected or non-regular Reign PID paths are not supported.' >&2
        return 1
    }
    install -d -o root -g root -m 0755 "$pid_directory" || return 1
    install -o root -g root -m 0644 /dev/null "$pidfile" || return 1
    if ! runuser -u reign -- env REIGN_DATA_ROOT="$data" REIGN_SAVE_SYNC_ROOT="$data/save-sync" REIGN_BANNERLORD_MODULES="$bannerlord_modules" REIGN_DB_NAME=reign REIGN_DB_HOST=/var/run/postgresql REIGN_DB_USER=reign \
        REIGN_VECTOR_PYTHON="$python_root/bin/python" REIGN_VECTOR_MODEL_DIR="$model_root" \
        sh -c 'umask 077; setsid "$1" --port 5101 --no-browser >> "$2/logs/server.log" 2>&1 < /dev/null & echo $!' \
        sh "$executable" "$data" 8>&- > "$pidfile"; then
        rm -f "$pidfile"
        return 1
    fi
}

start() {
    repair_permissions || return 1
    running && return 0
    local executable="$root/current/ReignServer"
    [ -x "$executable" ] || executable="$root/current/ReignBetaServer"
    [ -x "$executable" ] || { echo 'Reign runtime needs installation or repair.' >&2; exit 1; }
    install -d -o reign -g reign -m 700 "$data" "$data/logs"
    # Do not attach to or kill an unmanaged process already using Reign's port.
    if ss -ltnH 'sport = :5101' | grep -q .; then echo 'Reign internal port 5101 is already in use.' >&2; return 1; fi
    local python_root="$root/venv" model_root="$root/models"
    if [ -f "$root/current/embedding-model.lock.json" ]; then
        local requirements="$root/current/services/vector-worker/requirements-linux.txt"
        [ -f "$requirements" ] || requirements="$root/current/VectorWorker/requirements-linux.txt"
        [ -f "$requirements" ] || { echo 'Reign worker requirements are missing.' >&2; return 1; }
        python_root="$root/venvs/$(sha256sum "$requirements" | cut -d ' ' -f 1)"
        model_root="$root/model-versions/$(sha256sum "$root/current/embedding-model.lock.json" | cut -d ' ' -f 1)"
        [ -f "$python_root/.complete" ] && [ -d "$model_root" ] || { echo 'Reign dependencies need preparation.' >&2; return 1; }
    fi
    local bannerlord_modules
    bannerlord_modules=$(python3 - <<'PY'
import json,pathlib
bridge=pathlib.Path('/var/www/html/ReignServer/data/windows-bridge.json')
settings=json.loads(bridge.read_text()) if bridge.is_file() else {}
value=settings.get('bannerlordModules', '')
print(value if isinstance(value,str) and value.startswith('/mnt/') else '')
PY
)
    start_server_process "$executable" "$python_root" "$model_root" "$bannerlord_modules" || return 1
    for attempt in $(seq 1 45); do
        # Retained older builds lack schema fields; reported schema mismatches must fail activation.
        if curl -fsS --max-time 2 http://127.0.0.1:5101/health | python3 -c 'import json,sys; r=json.load(sys.stdin); version=r.get("databaseSchemaVersion"); legacy=not any(k in r for k in ("databaseSchemaVersion","requiredDatabaseSchemaVersion","databaseSchemaUpToDate")); schema_ok=legacy or (type(version) is int and version>0 and version==r.get("requiredDatabaseSchemaVersion") and r.get("databaseSchemaUpToDate") is True); ok=r.get("ok") and r.get("service")=="BannerlordReignServer" and r.get("protocolVersion")==1 and schema_ok; print("ReignServer database versioning check completed." if not legacy else "ReignServer uses an older build without database version reporting.") if ok else None; sys.exit(0 if ok else 1)' 2>/dev/null; then return 0; fi
        running || break
        sleep 1
    done
    echo "Reign startup failed. See $data/logs/server.log." >&2
    stop
    return 1
}

# Run one unit job while this process keeps the runtime lease (see lease_delegated).
managed() {
    local status=0
    install -d -o root -g root -m 0755 "${pidfile%/*}" || return 1
    [ ! -L "$delegate" ] || { echo 'Redirected Reign lifecycle delegation is not supported.' >&2; return 1; }
    printf '%s %s\n' "$$" "$(process_stamp "$$")" > "$delegate.$$" && mv -f "$delegate.$$" "$delegate" || return 1
    /usr/bin/systemctl "$1" "$unit" || status=$?
    rm -f "$delegate"
    return "$status"
}

unit_state() {
    local fields
    fields=$(/usr/bin/systemctl show "$unit" --property=ActiveState --property=MainPID) || return 1
    active=$(sed -n 's/^ActiveState=//p' <<<"$fields")
    main=$(sed -n 's/^MainPID=//p' <<<"$fields")
    [ -n "$active" ] && [[ "$main" =~ ^[0-9]+$ ]]
}

# Reign's loopback ports may belong only to the managed server's own session
# (owner 0: to nobody). A foreign owner is reported and never signalled.
listeners_owned_by() {
    local owner=$1 port lines line listener
    for port in 5101 5102; do
        lines=$(ss -ltnpH "sport = :$port") || { echo 'Reign listener ownership could not be inspected.' >&2; return 1; }
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            listener=$(grep -o 'pid=[0-9]*' <<<"$line" | cut -d = -f 2 | tr '\n' ' ' || true)
            for listener in ${listener:-0}; do
                if [ "$owner" = 0 ] || [ "$(ps -o sid= -p "$listener" 2>/dev/null | tr -d ' ' || true)" != "$owner" ]; then
                    echo "Reign port $port is used by a process outside the managed service; it was left running." >&2
                    return 1
                fi
            done
        done <<<"$lines"
    done
}

# running: the unit owns the recorded runtime process; stopped: nothing owns
# the runtime or its ports. Anything else is an unknown prior state.
service_state() {
    local active main
    unit_state || { echo 'Cannot inspect the managed Reign service.' >&2; return 1; }
    if [ "$active" = active ]; then
        running && [ "$pid" = "$main" ] || { echo 'Managed Reign service ownership could not be verified.' >&2; return 1; }
        listeners_owned_by "$main" || return 1
        echo running
        return 0
    fi
    [[ "$active" = inactive || "$active" = failed ]] && [ "$main" = 0 ] || { echo "The managed Reign service is $active; retry after it settles." >&2; return 1; }
    if running; then echo 'A Reign process is running outside the managed service. Use the ReignServer launcher recovery first.' >&2; return 1; fi
    listeners_owned_by 0 || return 1
    echo stopped
}

assert_stopped() {
    local active main
    unit_state && [[ "$active" = inactive || "$active" = failed ]] && [ "$main" = 0 ] || { echo 'The managed Reign service did not stop.' >&2; return 1; }
    ! running || { echo 'A Reign process is still running; runtime files were not replaced.' >&2; return 1; }
    listeners_owned_by 0
}

# A started runtime counts only when the unit, its PID record, the executable
# inode and port 5101 identify one managed process that reports healthy.
# Strict mode (activation targets) requires its identity and schema report;
# a restored older runtime may predate them.
verify_managed() {
    local strict=$1 active main lines
    unit_state && [ "$active" = active ] && [ "$main" -gt 1 ] || { echo 'The managed Reign service is not active.' >&2; return 1; }
    running && [ "$pid" = "$main" ] || { echo 'The managed service does not own the recorded Reign process.' >&2; return 1; }
    lines=$(ss -ltnpH 'sport = :5101') || return 1
    grep "pid=$main," <<<"$lines" >/dev/null || { echo 'Reign port 5101 is not served by the managed process.' >&2; return 1; }
    listeners_owned_by "$main" || return 1
    curl -fsS --max-time 5 http://127.0.0.1:5101/health | python3 -c 'import json,sys
r=json.load(sys.stdin); pid=int(sys.argv[1]); strict=sys.argv[2]=="1"
reported=any(k in r for k in ("databaseSchemaVersion","requiredDatabaseSchemaVersion","databaseSchemaUpToDate"))
v=r.get("databaseSchemaVersion")
schema=type(v) is int and v>0 and v==r.get("requiredDatabaseSchemaVersion") and r.get("databaseSchemaUpToDate") is True
ok=r.get("ok") is True and r.get("service")=="BannerlordReignServer" and r.get("protocolVersion")==1
if strict: ok=ok and schema and r.get("databaseName")=="reign" and r.get("processId")==pid
else: ok=ok and (schema or not reported) and r.get("databaseName","reign")=="reign" and r.get("processId",pid)==pid
sys.exit(0 if ok else 1)' "$main" "$strict" || { echo 'Reign health does not identify the managed process with a current reign schema.' >&2; return 1; }
    MAIN_PID=$main
}

database_schema() {
    runuser -u postgres -- psql -XAt -v ON_ERROR_STOP=1 -d reign -c "SELECT version FROM reign_meta.storage_version WHERE component='reign_postgresql';" 2>/dev/null || true
}

# Hash every file of a retained or staged runtime against its own manifest,
# optionally bound to an approved manifest digest. Only real regular files and
# directories are accepted: the whole tree is inventoried without following
# anything, and links, FIFOs, sockets, devices, extra and missing files are
# refused before the manifest or any other file is opened.
verify_tree() {
    python3 - "$1" "$2" <<'PY'
import hashlib,json,os,stat,sys
root=sys.argv[1]
try:
    mode=os.lstat(root).st_mode
except FileNotFoundError:
    mode=0
if not stat.S_ISDIR(mode):
    raise ValueError('Runtime directory is missing or redirected')
def fail(error):
    raise error
actual=set()
for parent,directories,names in os.walk(root, onerror=fail):
    for name in directories+names:
        path=os.path.join(parent, name)
        mode=os.lstat(path).st_mode
        if stat.S_ISREG(mode):
            actual.add(os.path.relpath(path, root).replace(os.sep, '/'))
        elif not stat.S_ISDIR(mode):
            raise ValueError('Artifact links and special files are not supported')
if 'reign-linux-artifact.json' not in actual:
    raise ValueError('Artifact manifest is missing')
actual.discard('reign-linux-artifact.json')
# Never follow or block on an entry replaced after the inventory.
def read(name):
    handle=os.open(os.path.join(root, name), os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(handle, 'rb') as stream:
        if not stat.S_ISREG(os.fstat(handle).st_mode):
            raise ValueError('Artifact entry is not a regular file')
        return stream.read()
raw=read('reign-linux-artifact.json')
if sys.argv[2] and hashlib.sha256(raw).hexdigest()!=sys.argv[2]:
    raise ValueError('Artifact manifest is not the approved deployment manifest')
manifest=json.loads(raw)
if manifest.get('schema')!='reign-linux-artifact-v1' or manifest.get('protocolVersion')!=1:
    raise ValueError('Unsupported artifact manifest or protocol')
files=manifest.get('files', {})
if not files or set(files)!=actual or not ({'ReignServer', 'ReignBetaServer'} & set(files)):
    raise ValueError('Artifact file inventory mismatch')
for name,digest in files.items():
    if hashlib.sha256(read(name)).hexdigest()!=digest:
        raise ValueError('Artifact checksum mismatch')
PY
}

# Return the prior runtime files and its prior running/stopped state. The player
# database is never restored; a schema change by the candidate is reported.
restore_prior() {
    files_restored=0
    managed stop || ( stop ) || true
    /usr/bin/systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    if ! assert_stopped; then
        echo "Recovery stopped before changing files: the candidate could not be stopped safely. Runtime ${version:-unknown} and its logs were preserved for review." >&2
        return 1
    fi
    # Errexit does not apply inside recovery; every file step is checked. The
    # candidate is renamed aside, never over an existing current.aborted, and
    # removed only once its bytes verify; a resumed recovery finishes the same way.
    # A current.next is likewise removed only while it holds exactly this
    # activation's retained candidate (a fully staged copy not yet swapped in);
    # anything else there, including any link or partial copy, stops recovery
    # before any runtime path changes.
    if present "$root/current.next" && ! { [ -n "$version" ] && runtime_is "$root/current.next" "$version"; }; then
        echo "Recovery stopped before changing files: $root/current.next is not the verified candidate runtime ${version:-unknown}; it was preserved for review." >&2
        return 1
    fi
    if present "$root/current.aborted" && ! remove_staged_candidate; then
        return 1
    fi
    if ! { { [ "$moved_candidate" = 0 ] || { ! present "$root/current.aborted" && mv -T "$root/current" "$root/current.aborted" && remove_staged_candidate; }; } &&
        { [ "$moved_prior" = 0 ] || { ! present "$root/current" && mv -T "$root/current.previous" "$root/current"; }; } &&
        { ! present "$root/current.next" || rm -rf -- "$root/current.next"; } &&
        if [ -n "$old_version" ]; then
            printf '%s\n' "$old_version" > "$root/current-version.next" && mv -f "$root/current-version.next" "$root/current-version"
        else
            rm -f "$root/current-version"
        fi; }; then
        echo "Recovery could not restore runtime files. Runtime ${version:-unknown}, current.previous and logs were preserved for review." >&2
        return 1
    fi
    [ "$metadata_created" = 0 ] || rm -f "$root/rollback-metadata/$version.json" || true
    files_restored=1
    if [ "$prior_state" = running ] && ! { managed start && verify_managed 0; }; then
        local schema_after
        schema_after=$(database_schema)
        echo "Prior runtime ${old_version:-none} was restored but did not start healthy. The database was not restored." >&2
        if [ -n "$schema_before" ] && [ "$schema_after" != "$schema_before" ]; then
            echo "The candidate changed the database schema from $schema_before to ${schema_after:-unknown}; restore requires a reviewed compatible build." >&2
        fi
        echo "Candidate runtime $version and logs were preserved for review." >&2
        return 1
    fi
    echo "Restored Reign runtime ${old_version:-none}; service $prior_state." >&2
}

recover_activation() {
    local status=$1
    trap - EXIT
    set +e
    if [ "$phase" != done ]; then
        echo 'Reign activation failed; restoring the prior runtime state.' >&2
        restore_prior
    fi
    exit "$status"
}

# True when <tree> holds exactly the retained bytes of <version>; with link-ok a
# legacy symlink selecting that retained version also qualifies.
runtime_is() {
    local sha
    if [ -L "$1" ]; then
        [ -n "${3:-}" ] && [ -d "$root/versions/$2" ] && [ "$(readlink -f -- "$1")" = "$(readlink -f -- "$root/versions/$2")" ]
        return
    fi
    # The reference digest comes only from a real retained directory's regular
    # manifest, opened without following or blocking on a replaced entry.
    [ -n "$2" ] || return 1
    sha=$(python3 - "$root/versions" "$2" 2>/dev/null <<'PY'
import hashlib,os,stat,sys
for path in (sys.argv[1], os.path.join(*sys.argv[1:])):
    if not stat.S_ISDIR(os.lstat(path).st_mode):
        raise ValueError('Retained runtime directory is redirected')
handle=os.open(os.path.join(*sys.argv[1:], 'reign-linux-artifact.json'), os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
with os.fdopen(handle, 'rb') as stream:
    if not stat.S_ISREG(os.fstat(handle).st_mode):
        raise ValueError('Retained manifest is not a regular file')
    print(hashlib.sha256(stream.read()).hexdigest())
PY
) || return 1
    verify_tree "$1" "$sha" 2>/dev/null
}

# Any entry at the path, including a dangling link.
present() {
    [ -e "$1" ] || [ -L "$1" ]
}

# current.aborted is removed only while it holds exactly the retained candidate
# bytes; anything else there, including any link, is left untouched for review.
remove_staged_candidate() {
    if [ -n "$version" ] && runtime_is "$root/current.aborted" "$version"; then
        rm -rf -- "$root/current.aborted" && return 0
        echo "Recovery could not finish removing the verified candidate at $root/current.aborted; the remainder was preserved for review." >&2
        return 1
    fi
    echo "Recovery stopped: $root/current.aborted is not the verified candidate runtime ${version:-unknown}; it was preserved for review." >&2
    return 1
}

# Abort may resume after any interrupted step. What current holds is decided
# from its verified bytes, never from current-version or the marker: while
# current.previous exists only the verified candidate is removed; once it is
# gone, current may already be the restored prior. Anything else is preserved.
abort_activation() {
    moved_prior=0 moved_candidate=0 files_restored=0
    if present "$root/current.previous"; then moved_prior=1; fi
    if present "$root/current"; then
        if [ "$moved_prior" = 0 ] && [ -n "$old_version" ] && runtime_is "$root/current" "$old_version" link-ok; then
            echo "Resuming an interrupted abort of $version: prior runtime $old_version is already selected." >&2
        elif runtime_is "$root/current" "$version"; then
            moved_candidate=1
        else
            echo "The selected Reign runtime is neither candidate $version nor prior ${old_version:-none}; nothing was changed and the pending activation was preserved for review." >&2
            return 1
        fi
    elif present "$root/current.aborted"; then
        echo "Resuming an interrupted abort of $version: verifying the staged candidate runtime before removal." >&2
    fi
    local status=0
    restore_prior || status=1
    # Keep the decision marker only while runtime files still need review.
    [ "$files_restored" = 0 ] || rm -f "$root/activation-pending"
    return "$status"
}

activation_receipt() {
    printf '{"schema":"reign-activation-v1","version":"%s","previousVersion":"%s","manifestSha256":"%s","state":"%s","mainPid":%s,"awaitingCommit":%s}\n' \
        "$version" "$old_version" "$manifest_sha" "$1" "$2" "$3"
}

case "$command" in
    configure-web)
        a2enmod proxy proxy_http cgid headers >/dev/null
        if ! grep -Eq '^[[:space:]]*Listen[[:space:]]+([^:[:space:]]+:)?8089([[:space:]]|$)' /etc/apache2/ports.conf; then
            printf 'Listen 0.0.0.0:8089\n' >> /etc/apache2/ports.conf
        fi
        cat > /etc/apache2/conf-available/reign-source.conf <<'EOF'
# Reign is a compiled application; never serve its source through another site's document root.
<Directory /var/www/html/ReignServer>
    Require all denied
</Directory>
EOF
        cat > /etc/apache2/sites-available/reign.conf <<'EOF'
<VirtualHost *:8089>
    ProxyRequests Off
    # Reign's HTTP listener reads bodies directly; Apache must acknowledge Expect first.
    Proxy100Continue Off
    # This fixed-action controller remains available while the application is off.
    ProxyPass /reign-control !
    ScriptAlias /reign-control /usr/local/lib/reign/reign-control.py
    <Directory /usr/local/lib/reign>
        Options +ExecCGI -Indexes
        Require all granted
    </Directory>
    ProxyErrorOverride On 502 503 504
    ErrorDocument 502 /reign-control/offline
    ErrorDocument 503 /reign-control/offline
    ErrorDocument 504 /reign-control/offline
    # Match the client's fifteen-minute interactive window, including provider retries.
    # An earlier proxy deadline replaces a valid pending response with the offline HTML page.
    # Always add the proxy's own X-Forwarded-* marker, even when a caller nominates peer headers in Connection.
    ProxyAddHeaders On
    # Global key mutations trust only these: always overwritten here, so a client can never supply its own peer or host.
    RequestHeader set X-Reign-Peer "expr=%{REMOTE_ADDR}"
    RequestHeader set X-Reign-Host "expr=%{HTTP_HOST}"
    # Substitute the captured route once. A literal target path is followed by the original request path.
    ProxyPassMatch ^(/portraits/generate)$ http://127.0.0.1:5101$1 timeout=1260
    ProxyPass / http://127.0.0.1:5101/ timeout=900
    ProxyPassReverse / http://127.0.0.1:5101/
    ErrorLog ${APACHE_LOG_DIR}/reign_error.log
    CustomLog ${APACHE_LOG_DIR}/reign_access.log combined
</VirtualHost>
EOF
        a2enconf reign-source >/dev/null
        a2ensite reign >/dev/null
        apache2ctl configtest
        # A graceful reload does not start the cgid daemon when first enabled.
        # This dedicated distro's proxy must restart before its control endpoint works.
        if pgrep -x apache2 >/dev/null; then service apache2 restart; fi
        ;;
    start) start ;;
    stop) stop ;;
    repair-permissions) repair_permissions ;;
    status) if running; then echo running; else echo stopped; fi ;;
    rollback-list) python3 /usr/local/bin/reign_versions.py list ;;
    prepare)
        [ -f "$source_root/ReignServer.csproj" ] || [ -f "$source_root/ReignBetaServer/ReignBetaServer.csproj" ] || exit 1
        [ ! -L "$root" ] && [ ! -L "$data" ] || { echo 'Redirected runtime roots are not supported.' >&2; exit 1; }
        install -d -m 755 "$root" "$root/versions"
        install -d -o reign -g reign -m 700 "$data"
        /usr/local/lib/reign/prepare-systemd-sessions.sh
        case "$(. /etc/os-release && echo "$ID:$VERSION_ID")" in
            debian:12) icu_package=libicu72 ;;
            debian:13) icu_package=libicu76 ;;
            *) echo 'Unsupported Debian release for the Reign runtime.' >&2; exit 1 ;;
        esac
        apt-get update -qq
        apt-get install -y --no-install-recommends python3-venv "$icu_package" libgssapi-krb5-2 ca-certificates curl acl
        repair_permissions
        requirements="$source_root/services/vector-worker/requirements-linux.txt"
        scripts="$source_root/scripts"
        release="$source_root/release"
        if [ ! -f "$requirements" ]; then
            requirements="$source_root/ReignBetaServer/VectorWorker/requirements-linux.txt"
            scripts="$source_root/ReignRelease"
            release="$source_root/ReignRelease"
        fi
        python_root="$root/venvs/$(sha256sum "$requirements" | cut -d ' ' -f 1)"
        model_root="$root/model-versions/$(sha256sum "$release/embedding-model.lock.json" | cut -d ' ' -f 1)"
        # Dependencies are immutable per source lock, so a failed update cannot change the running worker.
        if [ ! -f "$python_root/.complete" ]; then
            [ -x "$python_root/bin/python" ] || python3 -m venv "$python_root"
            "$python_root/bin/python" -m pip install --disable-pip-version-check -r "$requirements"
            "$python_root/bin/python" -m pip check
            touch "$python_root/.complete"
        fi
        "$python_root/bin/python" "$scripts/Prepare-LinuxRuntime.py" --model-directory "$model_root"
        ;;
    activate|rollback)
        # Start policy: --start (reviewed deployment) ends with the verified
        # candidate running; --leave-stopped (tester installation) never starts
        # it. With neither, as direct operator calls always did, the candidate is
        # health checked and the unit returns to its prior running/stopped state.
        # --await-commit keeps the prior runtime until the caller runs
        # commit-activation or abort-activation for this version.
        start_policy=prior await_commit=0 expected_manifest=
        for option in "${@:3}"; do
            case "$option" in
                --start) [ "$start_policy" = prior ] || exit 64; start_policy=running ;;
                --leave-stopped) [ "$start_policy" = prior ] || exit 64; start_policy=stopped ;;
                --await-commit) await_commit=1 ;;
                --manifest-sha256=*) expected_manifest=${option#*=}; [[ "$expected_manifest" =~ ^[0-9a-f]{64}$ ]] || exit 64 ;;
                *) echo 'Unknown activation option.' >&2; exit 64 ;;
            esac
        done
        [ "$#" -le 5 ] || exit 64
        if [ "$command" = rollback ]; then
            target=${2:?Supply a retained version ID}
            python3 /usr/local/bin/reign_versions.py check "$target"
            package="$root/versions/$target"
        else
            package=${2:?Supply an absolute validated Linux publish directory}
        fi
        executable=ReignServer
        [ -f "$package/$executable" ] || executable=ReignBetaServer
        [ "${package:0:1}" = / ] && [ -f "$package/$executable" ] && [ -f "$package/reign-linux-artifact.json" ] || exit 64
        # Review interrupted or uncommitted activations before changing anything.
        for leftover in current.next current.previous current.aborted activation-pending; do
            [ ! -e "$root/$leftover" ] && [ ! -L "$root/$leftover" ] || { echo "A previous Reign activation needs review ($leftover)." >&2; exit 1; }
        done
        old_version=$(cat "$root/current-version" 2>/dev/null || true)
        if [ -z "$old_version" ] && [ -L "$root/current" ]; then
            old_version=$(basename "$(readlink "$root/current")")
        fi
        [ -z "$old_version" ] || [[ "$old_version" =~ ^[0-9]{14}-[0-9]+$ ]] || exit 1
        prior_state=$(service_state) || exit 1
        schema_before=$(database_schema)
        python3 /usr/local/bin/reign_versions.py record
        fresh_copy=0
        if [ "$command" = rollback ]; then
            version=$target
        else
            version=$(date -u +%Y%m%d%H%M%S)-$$
            [ ! -e "$root/versions/$version" ] || exit 1
            fresh_copy=1
            install -d "$root/versions/$version"
            cp -a "$package/." "$root/versions/$version/"
        fi
        # DrvFS exposes Windows build artifacts with synthetic executable bits.
        # Normalize only this immutable retained version before activation.
        find -P "$root/versions/$version" -xdev -type d -exec chmod 0755 {} +
        find -P "$root/versions/$version" -xdev -type f -exec chmod 0644 {} +
        chmod 0755 "$root/versions/$version/$executable"
        # Verify the retained bytes themselves, bound to the approved manifest when supplied.
        if ! verify_tree "$root/versions/$version" "$expected_manifest"; then
            [ "$fresh_copy" = 0 ] || rm -rf -- "$root/versions/$version"
            echo 'The retained Reign artifact failed verification; nothing was activated.' >&2
            exit 1
        fi
        manifest_sha=$(sha256sum "$root/versions/$version/reign-linux-artifact.json" | cut -d ' ' -f 1)
        metadata_created=0
        [ -e "$root/rollback-metadata/$version.json" ] || metadata_created=1
        install -d "$root/current.next"
        cp -a "$root/versions/$version/." "$root/current.next/"
        if ! verify_tree "$root/current.next" "$manifest_sha"; then
            rm -rf -- "$root/current.next"
            echo 'The staged Reign runtime failed verification; nothing was activated.' >&2
            exit 1
        fi
        moved_prior=0 moved_candidate=0 phase=stopping
        trap 'recover_activation $?' EXIT
        if [ "$prior_state" = running ]; then managed stop; fi
        assert_stopped
        phase=swapping
        if [ -e "$root/current" ] || [ -L "$root/current" ]; then
            mv -T "$root/current" "$root/current.previous"
            moved_prior=1
        fi
        mv -T "$root/current.next" "$root/current"
        moved_candidate=1
        printf '%s\n' "$version" > "$root/current-version.next"
        mv -f "$root/current-version.next" "$root/current-version"
        phase=starting
        final_state=stopped MAIN_PID=0
        if [ "$start_policy" != stopped ]; then
            managed start || { echo 'The managed Reign service did not start the candidate.' >&2; exit 1; }
            verify_managed 1
            python3 /usr/local/bin/reign_versions.py record || echo 'Could not record rollback compatibility for this build.' >&2
            final_state=running
            # A failed return to stopped is recovered like any other failure.
            if [ "$start_policy" = prior ] && [ "$prior_state" = stopped ]; then
                managed stop
                assert_stopped
                final_state=stopped MAIN_PID=0
            fi
        fi
        if [ "$await_commit" = 1 ]; then
            printf '%s %s %s %s %s\n' "$version" "${old_version:--}" "$prior_state" "$metadata_created" "${schema_before:--}" > "$root/activation-pending.next"
            mv -f "$root/activation-pending.next" "$root/activation-pending"
        elif [ "$moved_prior" = 1 ]; then
            rm -rf -- "$root/current.previous"
        fi
        phase=done
        trap - EXIT
        if [ "$start_policy" = stopped ]; then
            echo 'Reign runtime activated; service left stopped; prior version retained.'
        elif [ "$final_state" = stopped ]; then
            echo 'Reign runtime activated and health checked; service returned to stopped; prior version retained.'
        else
            echo 'Reign runtime activated and health checked under the managed service; prior version retained.'
        fi
        activation_receipt "$final_state" "$MAIN_PID" "$([ "$await_commit" = 1 ] && echo true || echo false)"
        ;;
    commit-activation|abort-activation)
        [ "$#" = 2 ] && [[ "$2" =~ ^[0-9]{14}-[0-9]+$ ]] || exit 64
        marker="$root/activation-pending"
        [ -f "$marker" ] && [ ! -L "$marker" ] || { echo 'No Reign activation is awaiting a decision.' >&2; exit 1; }
        read -r version old_version prior_state metadata_created schema_before < "$marker" || exit 1
        [ "$old_version" != - ] || old_version=
        [ "$schema_before" != - ] || schema_before=
        selected=$(cat "$root/current-version" 2>/dev/null || true)
        [ "$version" = "$2" ] && { [ "$selected" = "$version" ] || { [ "$command" = abort-activation ] && [ "$selected" = "$old_version" ]; }; } &&
            { [ -z "$old_version" ] || [[ "$old_version" =~ ^[0-9]{14}-[0-9]+$ ]]; } &&
            [[ "$prior_state" =~ ^(running|stopped)$ && "$metadata_created" =~ ^[01]$ ]] ||
            { echo 'The pending Reign activation does not match this request; it was preserved.' >&2; exit 1; }
        if [ "$command" = commit-activation ]; then
            # An interrupted abort may already have removed or replaced the candidate.
            ! present "$root/current.aborted" && runtime_is "$root/current" "$version" ||
                { echo "Runtime $version is no longer the selected candidate (interrupted abort?); nothing was committed. Retry abort-activation $version." >&2; exit 1; }
            rm -rf -- "$root/current.previous"
            rm -f "$marker"
            echo "Reign activation $version committed."
        else
            status=0
            abort_activation || status=1
            exit "$status"
        fi
        ;;
    global-keys-enroll)
        # Bounded stdin from the Windows installer: the DwemerDistro consumer token never appears in argv, env or logs.
        # Stored outside data/ so support bundles cannot include it; the server re-reads it on every key operation.
        # The directory and any existing file must already be root-owned and unreplaceable by others; a symlink, wrong
        # owner or mode is refused, never repaired. On any failure the previous enrollment file is left untouched.
        python3 -I -c '
import grp, json, os, re, secrets, stat, sys
def refuse(message):
    sys.exit(message)
raw = sys.stdin.buffer.read(4097)
try:
    request = json.loads(raw) if len(raw) <= 4096 else None
except ValueError:
    request = None
if not isinstance(request, dict) or set(request) != {"client", "token", "socket", "providers"} \
        or not re.fullmatch(r"[A-Za-z0-9_-]{20,128}", str(request["token"])) \
        or request["client"] != "reign" or request["socket"] != "/mnt/wsl/dwemerdistro-keys/keys.sock":
    refuse("Invalid global keys enrollment.")
for parent in ("/etc",):
    info = os.lstat(parent)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        refuse("Untrusted /etc; enrollment refused.")
directory, path = "/etc/reignserver", "/etc/reignserver/global-keys.json"
if not os.path.lexists(directory):
    os.mkdir(directory, 0o755)
info = os.lstat(directory)
if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
    refuse("/etc/reignserver is not a root-owned directory; enrollment refused.")
group = grp.getgrnam("reign").gr_gid
if os.path.lexists(path):
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != group or info.st_mode & 0o7137:
        refuse("Existing global-keys.json has an unexpected type, owner or mode; enrollment refused.")
temp = path + "." + secrets.token_hex(8) + ".tmp"
fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
try:
    os.fchown(fd, 0, group)
    os.fchmod(fd, 0o640)
    with os.fdopen(fd, "w") as handle:
        json.dump({"schema": "reign-global-keys-v1", "client": request["client"], "socket": request["socket"], "token": request["token"]}, handle)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp, path)
    dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    os.fsync(dir_fd)
    os.close(dir_fd)
finally:
    if os.path.lexists(temp):
        os.unlink(temp)
print("Global API Keys enrollment saved.")
'
        ;;
    *) echo 'Usage: reignctl prepare|activate <validated-package> [--start|--leave-stopped] [--await-commit] [--manifest-sha256=<sha>]|commit-activation <version-id>|abort-activation <version-id>|rollback-list|rollback <version-id> [options]|repair-permissions|start|stop|status|global-keys-enroll' >&2; exit 64 ;;
esac
