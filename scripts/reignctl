#!/usr/bin/env bash
# Dedicated ReignServer WSL runtime lifecycle.
set -euo pipefail
root=/var/www/html/ReignServer/runtime
data=/var/www/html/ReignServer/data
source_root=/var/www/html/ReignServer
pidfile=/run/reignserver/server.pid
command=${1:-status}
if [ "$(id -u)" != 0 ]; then exec sudo "$0" "$@"; fi
case "$command" in
    prepare|configure-web|activate|start|stop|rollback|rollback-list|repair-permissions)
        exec 8>/run/lock/reignserver-runtime.lock
        flock -w 30 8 || { echo 'Another Reign runtime operation is running.' >&2; exit 75; }
        ;;
esac

running() {
    [ -s "$pidfile" ] || return 1
    pid=$(cat "$pidfile")
    [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    local executable
    for executable in "$root/current/ReignServer" "$root/current/ReignBetaServer"; do
        [ -f "$executable" ] && [ "$executable" -ef "/proc/$pid/exe" ] && return 0
    done
    return 1
}

stop() {
    if running; then
        # setsid creates an owned session, so only this server and its worker group receive signals.
        [ "$(ps -o sid= -p "$pid" | tr -d ' ')" = "$pid" ] || { echo 'Reign process ownership mismatch.' >&2; exit 1; }
        kill -TERM -- "-$pid"
        for attempt in $(seq 1 30); do running || break; sleep 1; done
        if running; then echo 'Reign did not stop cleanly; files were not replaced.' >&2; exit 1; fi
    fi
    rm -f "$pidfile"
}

# Windows UNC clients can create root-owned campaign files; keep server access inherited.
repair_permissions() {
    [ ! -L "$data" ] && [ ! -L "$data/campaigns" ] || { echo 'Redirected campaign roots are not supported.' >&2; return 1; }
    command -v setfacl >/dev/null || { echo 'Reign permissions need preparation (acl package missing).' >&2; return 1; }
    install -d -o reign -g reign -m 700 "$data" "$data/campaigns" || return 1
    # Do not traverse symlinks or other mounts, or change any campaign contents.
    find -P "$data/campaigns" -xdev \( -type d -o -type f \) -exec chown --no-dereference reign:reign {} + || return 1
    find -P "$data/campaigns" -xdev -type d -exec setfacl -m u::rwx,u:reign:rwx,g::---,o::---,d:u::rwx,d:u:reign:rwx,d:g::---,d:o::--- {} + || return 1
    find -P "$data/campaigns" -xdev -type f -exec setfacl -m u::rw,u:reign:rw,g::---,o::--- {} +
}

start() {
    repair_permissions || return 1
    running && return 0
    local executable="$root/current/ReignServer"
    [ -x "$executable" ] || executable="$root/current/ReignBetaServer"
    [ -x "$executable" ] || { echo 'Reign runtime needs installation or repair.' >&2; exit 1; }
    install -d -o reign -g reign -m 700 "$data" "$data/logs" /run/reignserver
    # Do not attach to or kill an unmanaged process already using Reign's port.
    if ss -ltnH 'sport = :5101' | grep -q .; then echo 'Reign internal port 5101 is already in use.' >&2; return 1; fi
    local python_root="$root/venv" model_root="$root/models"
    if [ -f "$root/current/embedding-model.lock.json" ]; then
        local requirements="$root/current/services/vector-worker/requirements-linux.txt"
        [ -f "$requirements" ] || requirements="$root/current/VectorWorker/requirements-linux.txt"
        [ -f "$requirements" ] || { echo 'Reign worker requirements are missing.' >&2; return 1; }
        python_root="$root/venvs/$(sha256sum "$requirements" | cut -d ' ' -f 1)"
        model_root="$root/model-versions/$(sha256sum "$root/current/embedding-model.lock.json" | cut -d ' ' -f 1)"
        [ -f "$python_root/.complete" ] && [ -d "$model_root" ] || { echo 'Reign dependencies need preparation.' >&2; return 1; }
    fi
    local bannerlord_modules
    bannerlord_modules=$(python3 - <<'PY'
import json,pathlib
bridge=pathlib.Path('/var/www/html/ReignServer/data/windows-bridge.json')
settings=json.loads(bridge.read_text()) if bridge.is_file() else {}
value=settings.get('bannerlordModules', '')
print(value if isinstance(value,str) and value.startswith('/mnt/') else '')
PY
)
    runuser -u reign -- env REIGN_DATA_ROOT="$data" REIGN_SAVE_SYNC_ROOT="$data/save-sync" REIGN_BANNERLORD_MODULES="$bannerlord_modules" REIGN_DB_NAME=reign REIGN_DB_HOST=/var/run/postgresql REIGN_DB_USER=reign \
        REIGN_VECTOR_PYTHON="$python_root/bin/python" REIGN_VECTOR_MODEL_DIR="$model_root" \
        sh -c 'umask 077; setsid "$1" --port 5101 --no-browser >> "$3/logs/server.log" 2>&1 < /dev/null & echo $! > "$2"' \
        sh "$executable" "$pidfile" "$data" 8>&-
    # Type=forking services may only adopt a process outside their cgroup when
    # the configured PID file is trusted. Keep process creation unprivileged,
    # then hand only the PID file back to the root-owned lifecycle controller.
    chown root:root "$pidfile"
    chmod 0644 "$pidfile"
    for attempt in $(seq 1 45); do
        # Retained older builds lack schema fields; reported schema mismatches must fail activation.
        if curl -fsS --max-time 2 http://127.0.0.1:5101/health | python3 -c 'import json,sys; r=json.load(sys.stdin); version=r.get("databaseSchemaVersion"); legacy=not any(k in r for k in ("databaseSchemaVersion","requiredDatabaseSchemaVersion","databaseSchemaUpToDate")); schema_ok=legacy or (type(version) is int and version>0 and version==r.get("requiredDatabaseSchemaVersion") and r.get("databaseSchemaUpToDate") is True); ok=r.get("ok") and r.get("service")=="BannerlordReignServer" and r.get("protocolVersion")==1 and schema_ok; print("ReignServer database versioning check completed." if not legacy else "ReignServer uses an older build without database version reporting.") if ok else None; sys.exit(0 if ok else 1)' 2>/dev/null; then return 0; fi
        running || break
        sleep 1
    done
    echo "Reign startup failed. See $data/logs/server.log." >&2
    stop
    return 1
}

case "$command" in
    configure-web)
        a2enmod proxy proxy_http >/dev/null
        if ! grep -Eq '^[[:space:]]*Listen[[:space:]]+([^:[:space:]]+:)?8089([[:space:]]|$)' /etc/apache2/ports.conf; then
            printf 'Listen 0.0.0.0:8089\n' >> /etc/apache2/ports.conf
        fi
        cat > /etc/apache2/conf-available/reign-source.conf <<'EOF'
# Reign is a compiled application; never serve its source through another site's document root.
<Directory /var/www/html/ReignServer>
    Require all denied
</Directory>
EOF
        cat > /etc/apache2/sites-available/reign.conf <<'EOF'
<VirtualHost *:8089>
    ProxyRequests Off
    # Reign's HTTP listener reads bodies directly; Apache must acknowledge Expect first.
    Proxy100Continue Off
    ProxyPass / http://127.0.0.1:5101/ timeout=300
    ProxyPassReverse / http://127.0.0.1:5101/
    ErrorLog ${APACHE_LOG_DIR}/reign_error.log
    CustomLog ${APACHE_LOG_DIR}/reign_access.log combined
</VirtualHost>
EOF
        a2enconf reign-source >/dev/null
        a2ensite reign >/dev/null
        apache2ctl configtest
        if pgrep -x apache2 >/dev/null; then service apache2 reload; fi
        ;;
    start) start ;;
    stop) stop ;;
    repair-permissions) repair_permissions ;;
    status) if running; then echo running; else echo stopped; fi ;;
    rollback-list) python3 /usr/local/bin/reign_versions.py list ;;
    prepare)
        [ -f "$source_root/ReignServer.csproj" ] || [ -f "$source_root/ReignBetaServer/ReignBetaServer.csproj" ] || exit 1
        [ ! -L "$root" ] && [ ! -L "$data" ] || { echo 'Redirected runtime roots are not supported.' >&2; exit 1; }
        install -d -m 755 "$root" "$root/versions"
        install -d -o reign -g reign -m 700 "$data"
        apt-get update -qq
        apt-get install -y --no-install-recommends python3-venv libicu72 libgssapi-krb5-2 ca-certificates curl acl
        repair_permissions
        requirements="$source_root/services/vector-worker/requirements-linux.txt"
        scripts="$source_root/scripts"
        release="$source_root/release"
        if [ ! -f "$requirements" ]; then
            requirements="$source_root/ReignBetaServer/VectorWorker/requirements-linux.txt"
            scripts="$source_root/ReignRelease"
            release="$source_root/ReignRelease"
        fi
        python_root="$root/venvs/$(sha256sum "$requirements" | cut -d ' ' -f 1)"
        model_root="$root/model-versions/$(sha256sum "$release/embedding-model.lock.json" | cut -d ' ' -f 1)"
        # Dependencies are immutable per source lock, so a failed update cannot change the running worker.
        if [ ! -f "$python_root/.complete" ]; then
            [ -x "$python_root/bin/python" ] || python3 -m venv "$python_root"
            "$python_root/bin/python" -m pip install --disable-pip-version-check -r "$requirements"
            "$python_root/bin/python" -m pip check
            touch "$python_root/.complete"
        fi
        "$python_root/bin/python" "$scripts/Prepare-LinuxRuntime.py" --model-directory "$model_root"
        ;;
    activate|rollback)
        if [ "$command" = rollback ]; then
            target=${2:?Supply a retained version ID}
            python3 /usr/local/bin/reign_versions.py check "$target"
            package="$root/versions/$target"
        else
            package=${2:?Supply an absolute validated Linux publish directory}
        fi
        executable=ReignServer
        [ -f "$package/$executable" ] || executable=ReignBetaServer
        [ "${package:0:1}" = / ] && [ -f "$package/$executable" ] && [ -f "$package/reign-linux-artifact.json" ] || exit 64
        python3 - "$package" <<'PY'
import hashlib,json,pathlib,sys
root=pathlib.Path(sys.argv[1]).resolve()
manifest=json.loads((root/'reign-linux-artifact.json').read_text())
if manifest.get('schema')!='reign-linux-artifact-v1' or manifest.get('protocolVersion')!=1:
    raise ValueError('Unsupported artifact manifest or protocol')
files=manifest.get('files', {})
actual={p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file() and p.relative_to(root).as_posix()!='reign-linux-artifact.json'}
if not files or set(files)!=actual or not ({'ReignServer', 'ReignBetaServer'} & set(files)):
    raise ValueError('Artifact file inventory mismatch')
if any(p.is_symlink() for p in root.rglob('*')):
    raise ValueError('Artifact symlinks are not supported')
for name,digest in manifest['files'].items():
    path=(root/name).resolve()
    if not path.is_relative_to(root) or hashlib.sha256(path.read_bytes()).hexdigest()!=digest:
        raise ValueError('Artifact checksum mismatch')
PY
        python3 /usr/local/bin/reign_versions.py record
        if [ "$command" = rollback ]; then
            version=$target
        else
            version=$(date -u +%Y%m%d%H%M%S)-$$
            install -d "$root/versions/$version"
            cp -a "$package/." "$root/versions/$version/"
        fi
        # DrvFS exposes Windows build artifacts with synthetic executable bits.
        # Normalize only this immutable retained version before activation.
        find -P "$root/versions/$version" -xdev -type d -exec chmod 0755 {} +
        find -P "$root/versions/$version" -xdev -type f -exec chmod 0644 {} +
        chmod 0755 "$root/versions/$version/$executable"
        old_version=$(cat "$root/current-version" 2>/dev/null || true)
        if [ -z "$old_version" ] && [ -L "$root/current" ]; then
            old_version=$(basename "$(readlink "$root/current")")
        fi
        [ -z "$old_version" ] || [[ "$old_version" =~ ^[0-9]{14}-[0-9]+$ ]] || exit 1
        [ ! -e "$root/current.next" ] && [ ! -L "$root/current.next" ] || { echo 'A previous Reign activation needs review.' >&2; exit 1; }
        [ ! -e "$root/current.previous" ] && [ ! -L "$root/current.previous" ] || { echo 'A previous Reign activation backup needs review.' >&2; exit 1; }
        install -d "$root/current.next"
        cp -a "$root/versions/$version/." "$root/current.next/"
        was_running=0
        if running; then was_running=1; fi
        stop
        if [ -e "$root/current" ] || [ -L "$root/current" ]; then
            mv -T "$root/current" "$root/current.previous"
        fi
        mv -T "$root/current.next" "$root/current"
        printf '%s\n' "$version" > "$root/current-version.next"
        mv -f "$root/current-version.next" "$root/current-version"
        if ! start; then
            rm -rf -- "$root/current"
            if [ -e "$root/current.previous" ] || [ -L "$root/current.previous" ]; then
                mv -T "$root/current.previous" "$root/current"
            fi
            if [ -n "$old_version" ]; then
                printf '%s\n' "$old_version" > "$root/current-version.next"
                mv -f "$root/current-version.next" "$root/current-version"
                [ "$was_running" = 0 ] || start
            else
                rm -f "$root/current-version"
            fi
            exit 1
        fi
        python3 /usr/local/bin/reign_versions.py record || echo 'Could not record rollback compatibility for this build.' >&2
        [ "$was_running" = 1 ] || stop
        if [ -e "$root/current.previous" ] || [ -L "$root/current.previous" ]; then
            rm -rf -- "$root/current.previous"
        fi
        echo 'Reign runtime activated and health checked; prior version retained.'
        ;;
    *) echo 'Usage: reignctl prepare|activate <validated-package>|rollback-list|rollback <version-id>|repair-permissions|start|stop|status' >&2; exit 64 ;;
esac
