<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ReignLiveTest</AssemblyName>
    <RootNamespace>ReignLiveTest</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\ReignBeta\server\app\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <None Update="scenarios\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\reign.testing.json" Link="reign.testing.json" LogicalName="Reign.TestingCatalog.json" />
  </ItemGroup>
</Project>
